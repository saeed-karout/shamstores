# ==================================================
# backend/.env.example
# انسخ هذا الملف إلى backend/.env واملأ القيم.
# لا تضع أي أسرار حقيقية في هذا الملف — إنه مُتتبَّع في Git.
# ==================================================

# ---------- الخادم ----------
PORT=5000
NODE_ENV=development

# ---------- قاعدة البيانات (MySQL) ----------
# على Heroku مع إضافة JawsDB يُضبط هذا تلقائياً من JAWSDB_URL
DATABASE_URL="mysql://user:password@host:3306/dbname"

# ---------- الجلسات ----------
# ⚠️ مطلوب. ولّده بـ: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# يجب ألا يقل عن 32 حرفاً، ولا يُقبل في الإنتاج إن كان قيمة افتراضية معروفة.
JWT_SECRET=
JWT_EXPIRE=7d

# ---------- النطاقات ----------
# النطاق الأساسي للمنصة بدون بروتوكول — يُستخدم للنطاقات الفرعية وتعليمات DNS
APP_DOMAIN=shamstores.com
CLIENT_URL=http://localhost:3000
# نطاقات إضافية مسموح بها في CORS، مفصولة بفواصل
ALLOWED_ORIGINS=
# نطاقات Socket.IO المسموح بها (تُدمج مع ما سبق)
SOCKET_CORS_ORIGIN=

# ---------- سلوك التشغيل ----------
# تقديم ملفات الواجهة المبنية من نفس السيرفر (النشر بتطبيق Heroku واحد)
SERVE_FRONTEND=true
# عدد الوكلاء أمام التطبيق (1 على Heroku، false محلياً)
TRUST_PROXY=false
# حد حجم جسم الطلب بصيغة JSON
JSON_BODY_LIMIT=1mb
# true لتعطيل حدود المعدل أثناء الاختبار فقط
DISABLE_RATE_LIMIT=false
# true لإبقاء console.log مفعّلاً في الإنتاج (لأغراض التشخيص فقط)
VERBOSE_LOGS=false

# ---------- Cloudflare R2 (تخزين الصور) ----------
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=

# ---------- البريد (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Sham Stores

# ---------- Firebase (تسجيل الدخول عبر Google) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
