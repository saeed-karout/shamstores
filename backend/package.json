    "prisma:validate": "prisma validate",
    "prisma:db-push": "prisma db push",
    "migrate:controllers": "node scripts/migrate-controllers-to-prisma.js",
    "migration:check": "node scripts/check-migration.js",
    "migration:verify": "node scripts/verify-migration.js",
    "migration:run": "npm run prisma:setup && npm run migrate:controllers && npm run build",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "npm run db:migrate:undo:all && npm run db:migrate",
    "migrate:features": "node scripts/migrate-features.js",
    "backfill:subdomains": "node scripts/backfill-subdomains.js"
