    "build": "tsc",
    "prod": "npm run build && npm start",
    "prisma:setup": "node scripts/setup-prisma-complete.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
