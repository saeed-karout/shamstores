generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  super_admin
  owner
  staff
  user
  delivery_driver
}

enum OrderStatus {
  pending
  preparing
  ready
  delivering
  delivered
  served
  cancelled
}

enum PaymentMethod {
  cash
  card
  online
  /// شام كاش — محفظة سورية. يُفعّلها كل نشاط من إعداداته ويضع رقم حسابه.
  sham_cash
}

enum OrderType {
  dine_in
  delivery
  takeaway
  /// شحنٌ إلى محافظة أخرى عبر شركة شحن.
  ///
  /// **منفصلٌ عن `delivery` عمداً:** التوصيل يذهب إلى سائق المتجر، والشحن
  /// لا. ولو وُضعا في قيمةٍ واحدة لأُسنِد طلبُ حلبَ إلى سائقٍ في دمشق —
  /// وهو ما يجعل السائق يرفض والطلب يتعطّل بلا سببٍ ظاهر.
  shipping
}

enum DiscountType {
  percentage
  fixed
}

enum BusinessType {
  restaurant
  store
}

enum SettingType {
  string
  number
  boolean
  json
  array
}

enum SettingGroup {
  general
  auth
  business
  subscription
  payment
  domain
  storage
  delivery
  notification
  security
  analytics
  seo
}

enum ContactMessageStatus {
  new
  read
  replied
  archived
}

// ==================== MODELS ====================

model User {
  id                 String    @id @default(cuid())
  restaurantId       String?
  storeId            String?
  name               String
  email              String    @unique
  password           String
  phone              String?
  /// صورة الحساب — رابط في R2. الاسم والهاتف والصورة وحدها يملكها المستخدم؛
  /// البريد والدور وارتباط النشاط تُغيَّر من الإدارة لا من صفحة الحساب.
  avatarUrl          String?
  role               UserRole
  permissions        Json?
  isActive           Boolean   @default(true)
  isOnline           Boolean   @default(false)
  lastLogin          DateTime?
  lastLocationLat    Float?
  lastLocationLng    Float?
  lastLocationUpdate DateTime?
  driverRating       Float?    @default(0)
  driverRatingCount  Int?      @default(0)
  isEmailVerified    Boolean   @default(false)
  loginAttempts      Int       @default(0)
  lockedUntil        DateTime?
  /// رمز إشعارات مفرد — يبقى للتوافق مع تطبيق السائق القديم.
  /// الأجهزة المتعدّدة في `deviceTokens`: تاجرٌ يفتح اللوحة على الهاتف
  /// والحاسوب معاً كان أحدهما يمحو رمز الآخر.
  fcmToken           String?
  /// محادثة تيليجرام المرتبطة — بها يصله تنبيه الطلب والهاتف مقفل
  telegramChatId     String?
  /// رمز ربطٍ لمرّة واحدة يُمرَّر في رابط `t.me/bot?start=...`
  telegramLinkCode   String?   @unique
  telegramLinkedAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  ownedStores       Store[]                @relation("StoreOwner")
  ownedRestaurants  Restaurant[]           @relation("RestaurantOwner")
  restaurant        Restaurant?            @relation("RestaurantUsers", fields: [restaurantId], references: [id])
  stores            Store[]                @relation("StoreUsers")
  drivers           Driver[]
  /// الطلبات المعيَّنة إليه كسائق
  assignedOrders    Order[]                @relation("AssignedDeliveries")
  tickets           Ticket[]
  orders            Order[]                @relation("CreatedOrders")
  firebaseUser      FirebaseUser?
  notifications     Notification[]
  deviceTokens      DeviceToken[]
  productReviews    ProductReview[]
  /// تعليقاته على المنتجات والوجبات — `SetNull` عند حذفه: النقاش يبقى باسمه المكتوب
  itemComments      ItemComment[]
  subscriptions     CustomerSubscription[]
  affiliateProfiles Affiliate[]

  @@index([email])
  @@index([restaurantId])
  @@index([storeId])
  @@index([role])
}

/// أجهزة المستخدم التي تستقبل إشعارات الدفع.
///
/// **لماذا جدول لا عمود:** `User.fcmToken` مفرد، فتاجرٌ يفتح اللوحة على
/// الهاتف ثم على الحاسوب يمحو رمز الأوّل بالثاني — فيظنّ أنه مشترك
/// والإشعار يذهب إلى جهازٍ تركه. والرموز تُدوَّر وتموت، فالجدول يسمح
/// بحذف الميّت وحده بدل تصفير المستخدم.
model DeviceToken {
  id         String   @id @default(cuid())
  /// صاحب الجهاز إن كان له حساب.
  ///
  /// **اختياريّ عمداً:** زبائن المتاجر يطلبون كضيوف بلا تسجيل — وكان
  /// إلزامُه يعني أن جهاز الزبون لا يُسجَّل أصلاً، فلا يصله إشعارٌ مهما
  /// أذِن. أي أن إشعارات الويب كانت للتجّار وحدهم بحكم عمودٍ في المخطّط.
  userId     String?  @map("user_id")
  /// معرّف زائرٍ يولّده المتصفّح ويحفظه — بديل الحساب لمن لا حساب له
  visitorId  String?  @map("visitor_id")
  /// رمز FCM — فريدٌ عالمياً، وإعادة تسجيله من جهاز آخر تنقل ملكيّته
  token      String   @unique @db.VarChar(512)
  /// web | android | ios — به نعرف أي منصّة تفشل حين تفشل
  platform   String   @default("web")
  label      String?
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([visitorId])
  @@map("device_tokens")
}

/// اشتراك زبونٍ في تنبيهات نشاطٍ بعينه.
///
/// **يفصل الإذن عن العنوان.** العنوان محفوظ على المستخدم مرّةً واحدة
/// (`telegramChatId` و`deviceTokens` والبريد)، وهذا الجدول يقول **من يحقّ
/// له مراسلته عليه**. بدون الفصل، زبونٌ يشتري من ثلاثة متاجر يتلقّى حملات
/// الثلاثة بإذنٍ أعطاه لواحد، وإلغاؤه لدى أحدها يقطعه عن جميعها.
///
/// **وتتبّع الطلب منفصل عن التسويق** (`marketingOptIn`): من قبل أن يعرف
/// أين وصل طلبه لم يقبل إعلانات. خلطهما يحرق القناة — تيليجرام يحظر
/// البوتات المُبلَّغ عنها، والمتصفّح يحجب الموقع نهائياً بعد تجاهلٍ متكرّر،
/// وكلاهما لا يُسترجع.
///
/// `businessId` + `businessType` بدل عمودين اختياريين: القيد الفريد على
/// أعمدةٍ قد تكون NULL لا يمنع التكرار في MySQL — والنمط نفسه في
/// `BusinessFeature`.
/// سلّةٌ بدأها زبونٌ ولم يُتمّها.
///
/// **لقطةٌ لا مرآة:** السلّة الحقيقية تعيش في متصفّح الزبون. ما يُحفظ هنا
/// صورةٌ تُلتقط عند بلوغه صفحة الدفع — أي عند أوّل لحظةٍ يصير فيها للسلّة
/// قيمةٌ تسويقية وهويّةٌ يُذكَّر بها صاحبها. حفظُ كل تغييرٍ في السلّة كان
/// سيملأ الجدول بعرباتٍ من متصفّحين يتفرّجون.
model AbandonedCart {
  id           String @id @default(cuid())
  businessId   String @map("business_id")
  /// restaurant | store
  businessType String @map("business_type")

  /// من صاحبها — أيّهما توفّر
  subjectKey String  @map("subject_key")
  userId     String? @map("user_id")
  visitorId  String? @map("visitor_id")
  phone      String?

  /// أسماء الأصناف وكمّياتها — للرسالة لا لإعادة بناء السلّة
  items     Json
  total     Float
  itemCount Int   @default(0) @map("item_count")

  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  /// وقت إرسال التذكير — صفٌّ نُبّه عليه لا يُنبَّه ثانية
  notifiedAt   DateTime? @map("notified_at")
  /// وقت إتمام الطلب — سلّةٌ اكتملت لا تُطارَد
  recoveredAt  DateTime? @map("recovered_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([subjectKey, businessId])
  @@index([businessId, businessType, recoveredAt, notifiedAt])
  @@index([phone])
  @@map("abandoned_carts")
}

/// سجلّ ما أرسلته القواعد التلقائية.
///
/// **غرضه منع التكرار لا التقرير:** بلا سجلٍّ يعيد المجدول إرسال «اشتقنا
/// لك» لنفس الزبون كل ليلة، فيتحوّل التذكير إلى مضايقةٍ تُلغي الاشتراك.
model AutomationSend {
  id           String @id @default(cuid())
  businessId   String @map("business_id")
  businessType String @map("business_type")
  /// lapsed | abandoned_cart
  rule         String

  subjectKey String  @map("subject_key")
  channel    String
  /// نجح الإرسال أم لا — الفاشل لا يمنع محاولةً لاحقة
  ok         Boolean @default(true)

  sentAt DateTime @default(now()) @map("sent_at")

  @@index([businessId, rule, subjectKey, sentAt])
  @@index([sentAt])
  @@map("automation_sends")
}

/// زبونٌ يعرفه التاجر ولم يطلب من المتجر بعد.
///
/// **لماذا جدولٌ جديد ولا يكفي `CustomerSubscription`:** الأخير جدول
/// اشتراكاتٍ يحمل قناةً وموافقة، ولا يحمل اسماً — الأسماء تعيش على `User`،
/// والمستورد لا حساب له. فتخزينه هناك يفقد اسمه، وهو أوّل ما يريده التاجر.
///
/// **والهاتف مطلوب لا اختياريّ:** هو المعرّف الذي يُميّز الضيوف في كل هذا
/// المشروع (`guest:<هاتف>`). وجهةُ الاستيراد أن يندمج المستورد بطلباته
/// حين يطلب — وبلا هاتفٍ لا اندماج ولا وصول، فيصير صفّاً لا يُنتفع به.
///
/// **والموافقة التسويقية `false` افتراضاً:** قائمةٌ مستوردة ليست جمهوراً
/// موافقاً. التاجر يؤكّد الموافقة صريحاً عند الاستيراد إن كانت لديه.
model CustomerContact {
  id             String   @id @default(cuid())
  businessId     String   @map("business_id")
  businessType   String   @map("business_type")
  name           String
  phone          String
  email          String?
  note           String?  @db.Text
  /// `import` أو `manual` — يميّز من أُدخل بالملفّ عمّن أُضيف باليد
  source         String   @default("import")
  marketingOptIn Boolean  @default(false) @map("marketing_opt_in")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([businessId, businessType, phone])
  @@index([businessId, businessType])
  @@map("customer_contacts")
}

model CustomerSubscription {
  id           String @id @default(cuid())
  /// **المفتاح الثابت للمشترك** — معرّف الحساب أو معرّف الزائر.
  ///
  /// عمودٌ واحد يحمل الهوية أيّاً كان مصدرها، لأن التفرّد لا يستقيم على
  /// عمودٍ يقبل NULL: مايسكيوإل يسمح بتكرار القيم الفارغة، فكان ضيفٌ واحد
  /// يستطيع إنشاء عددٍ لا نهائي من الاشتراكات لنفس المتجر.
  subjectKey   String @map("subject_key")
  userId       String? @map("user_id")
  /// معرّف الزائر لمن لا حساب له
  visitorId    String? @map("visitor_id")
  /// الهاتف كما أدخله عند الطلب — لربط الاشتراك بطلباته لاحقاً
  phone        String?
  businessId   String @map("business_id")
  /// restaurant | store
  businessType String @map("business_type")
  /// telegram | push | email
  channel      String

  /// وافق على رسائل تسويقية لا على تتبّع طلبه وحده
  marketingOptIn Boolean   @default(false) @map("marketing_opt_in")
  /// إلغاءٌ لا حذف: سجلّ الرفض يمنع إعادة إضافته بطلبٍ لاحق
  unsubscribedAt DateTime? @map("unsubscribed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subjectKey, businessId, channel])
  @@index([businessId, businessType, marketingOptIn])
  @@index([phone])
  @@map("customer_subscriptions")
}

/// مسوّقٌ بالعمولة لنشاطٍ بعينه.
///
/// `businessId` + `businessType` كنمط `BusinessFeature` — لا عمودان
/// اختياريان: القيد الفريد على أعمدةٍ قد تكون NULL لا يمنع التكرار في MySQL.
///
/// و`userId` اختياري: كثير من المسوّقين في السوق أشخاصٌ بلا حساب على
/// المنصّة — اسمٌ ورقم هاتف يكفيان لتسجيلهم وحساب عمولتهم.
model Affiliate {
  id           String  @id @default(cuid())
  businessId   String  @map("business_id")
  /// restaurant | store
  businessType String  @map("business_type")
  userId       String? @map("user_id")

  name  String
  phone String?
  /// الرمز الذي يوزّعه المسوّق — يظهر في الرابط `?ref=CODE`
  code  String  @unique

  /// نسبة العمولة المئوية وقت الإسناد
  commissionRate Float   @default(5)
  isActive       Boolean @default(true) @map("is_active")

  /// زيارات وصلت برابطه — تقيس جهده حتى قبل أوّل بيعة
  clicks Int @default(0)

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  referrals AffiliateReferral[]

  @@index([businessId, businessType, isActive])
  @@index([userId])
  @@map("affiliates")
}

/// طلبٌ مُسنَد إلى مسوّق.
///
/// **العمولة تُجمَّد وقت الإسناد** (`commissionRate` منسوخة هنا): تغييرُ
/// النسبة لاحقاً يجب ألّا يعيد حساب عمولاتٍ استُحقّت بنسبةٍ أخرى — ولا أن
/// يخفضها بأثرٍ رجعي على مسوّقٍ عمل بها.
///
/// **وتُحتسب على المنتجات لا على الفاتورة**: رسوم التوصيل ليست بيعاً حقّقه
/// المسوّق، ودفعُ عمولةٍ عليها خسارةٌ صافية للتاجر.
model AffiliateReferral {
  id          String @id @default(cuid())
  affiliateId String @map("affiliate_id")
  /// فريد: طلبٌ واحد لا يُسنَد مرّتين مهما تكرّر النداء
  orderId     String @unique @map("order_id")

  /// الأساس الذي حُسبت عليه العمولة — يُحفظ للمراجعة لا للعرض
  baseAmount     Float @map("base_amount")
  commissionRate Float @map("commission_rate")
  commission     Float

  /// pending: الطلب لم يكتمل بعد · approved: اكتمل واستُحقّت
  /// cancelled: أُلغي الطلب فسقطت · paid: دُفعت للمسوّق
  status String @default("pending")

  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([affiliateId, status])
  @@map("affiliate_referrals")
}

model EmailVerificationCode {
  id        String    @id @default(cuid())
  email     String
  code      String    @unique
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([code])
  @@index([expiresAt])
}

model FirebaseUser {
  id           String   @id @default(cuid())
  userId       String   @unique
  firebaseUid  String   @unique
  displayName  String?
  photoUrl     String?
  authProvider String   @default("google")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([firebaseUid])
  @@index([userId])
}

model Plan {
  id             String  @id @default(cuid())
  name           String  @unique
  slug           String  @unique
  description    String?
  price          Float
  billingCycle   String?
  maxRestaurants Int     @default(1)
  maxStores      Int     @default(1)
  maxUsers       Int     @default(5)
  maxMenuItems   Int     @default(100)
  maxProducts    Int     @default(100)
  maxOrders      Int     @default(1000)
  features       Json?
  isActive       Boolean @default(true)
  position       Int     @default(0)
  isPopular      Boolean @default(false)

  hasWhatsapp        Boolean @default(false)
  hasOnlineOrders    Boolean @default(false)
  hasCustomDomain    Boolean @default(false)
  hasAnalytics       Boolean @default(false)
  hasTableQr         Boolean @default(false)
  hasMultiLanguage   Boolean @default(false)
  hasPromotions      Boolean @default(false)
  hasCoupons         Boolean @default(false)
  hasBrandingRemoval Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  restaurants Restaurant[]
  stores      Store[]

  @@index([slug])
}

model Restaurant {
  id                       String  @id @default(cuid())
  planId                   String
  name                     String
  slug                     String  @unique
  email                    String?
  phone                    String?
  userId                   String?
  whatsapp                 String?
  address                  String?
  description              String?
  /// الاسم والوصف بالإنجليزية — يظهران حين يبدّل الزبون اللغة.
  ///
  /// **كانا غائبين تماماً:** بُني زرّ اللغة وترجمة الواجهة، وبقي اسم المتجر
  /// ووصفه عربيّين مهما بدّل الزبون — لأنه لا حقل يحملهما. الفراغ يرتدّ إلى
  /// العربية، فمن لم يترجم لا يخسر شيئاً.
  nameEn                       String?
  descriptionEn                String?
  logo                     String?
  coverImage               String?
  instagram                String?
  facebook                 String?
  tiktok                   String?
  latitude                 Float?
  longitude                Float?
  showAllBranchesMenuItems Boolean @default(false)
  primaryColor             String  @default("#084835")
  secondaryColor           String  @default("#C07CDF")
  backgroundColor          String  @default("#F6F8F5")
  cardColor                String  @default("#FFFFFF")
  surfaceColor             String  @default("#EEF3EF")
  textColor                String  @default("#10231B")
  mutedColor               String  @default("#647870")
  accentColor              String  @default("#084835")
  fontFamily               String  @default("Cairo")

  /// شكل واجهة المتجر: القالب والنماذج والاستدارات — لا الألوان.
  ///
  /// عمودٌ واحد بصيغة JSON لا أربعة عشر عموداً: الحقول هنا ذوقٌ يتوسّع
  /// (نموذج بطاقة، نموذج صفحة، استدارة لكل عنصر)، وكل إضافة كانت ستعني
  /// ترحيلاً جديداً. ولا يُستعلَم عنه ولا يُرشَّح به فلا يخسر شيئاً.
  ///
  /// الفراغ مقصود: متجرٌ بلا قيمة يأخذ القالب الافتراضي في الواجهة.
  storefrontDesign         Json?

  // ✅ أضف هذه الحقول الجديدة هنا
  timezone String @default("Asia/Riyadh")
  currency String @default("SYP")
  language String @default("ar")

  subdomain                    String?   @unique
  customDomain                 String?   @unique
  customDomainVerified         Boolean?  @default(false)
  customDomainVerifiedAt       DateTime?
  customDomainVerificationCode String?   @unique
  /// معرّف Custom Hostname في Cloudflare — به نقرأ الحالة ونحذف عند فكّ الربط
  customDomainHostnameId       String?
  /// «تاجر موثّق»: متى وافق المشرف على هوية صاحب النشاط. `null` = غير موثّق.
  /// تاريخٌ لا عَلَم: يقول متى تحقّقنا، ويُمسح عند سحب التوثيق.
  verifiedAt                   DateTime?
  /// حالة النطاق عند Cloudflare: pending / active / blocked …
  customDomainStatus           String?
  /// حالة شهادة TLS — النطاق لا يعمل على https قبل أن تصبح active
  customDomainSslStatus        String?
  /// آخر مزامنة مع Cloudflare
  customDomainCheckedAt        DateTime?
  /// آخر خطأ تحقّق، يُعرض للتاجر لأن سببه في إعداد نطاقه
  customDomainError            String?   @db.Text
  isActive                     Boolean   @default(true)
  deliverySettings             Json?
  /// إعدادات طرق الدفع لكل نشاط: { shamCash: { enabled, accountNumber, accountName, note } }
  paymentSettings              Json?
  /// خيارات إتمام الطلب: خطوة واتساب، المعاينة قبل الدفع، هدايا المغتربين،
  /// والعربون — راجع services/checkoutExtras.service.ts
  checkoutSettings             Json?
  /// اللغات المفعّلة في واجهة الزبون، مثل ["ar"] أو ["ar","en"].
  /// العربية وحدها متاحة بلا ميزة multi_language — راجع services/language.service.ts
  enabledLanguages             Json?
  /// عملات العرض المفعّلة، مثل ["SYP"] أو ["SYP","USD"].
  /// الأسعار تُخزَّن بالليرة دائماً؛ هذه عملات **عرض** لا تخزين، والدولار
  /// منها يتطلّب سعر صرف مضبوطاً من السوبر أدمن — راجع services/currency.service.ts
  enabledCurrencies            Json?
  /// عملة **إدخال** الأسعار: "SYP" (الافتراضي) أو "USD".
  /// بالدولار يُخزَّن `priceUsd` لكل صنف، ويبقى `price` بالليرة مشتقّاً منه
  /// بسعر الصرف — فكل القراءات القائمة تعمل كما هي. راجع services/usdPricing.service.ts
  pricingCurrency              String    @default("SYP")
  /// "platform" (سعر المنصّة الموحّد) أو "custom" (سعر التاجر اليومي)
  usdRateSource                String    @default("platform")
  /// سعر التاجر الخاص: كم ليرة للدولار. يُقسَم عند إعادة تقويم الليرة.
  customUsdRate                Float?
  customUsdRateUpdatedAt       DateTime?
  /// تقريب السعر المحسوب لأقرب مضاعف (100، 500، 1000…). صفر = بلا تقريب.
  priceRoundingStep            Float     @default(0)
  /// إعدادات الرسائل التلقائية.
  ///
  /// `{ lapsed: { enabled, afterDays, title, body }, abandonedCart: { … } }`
  /// راجع services/automation.service.ts — هو المرجع الوحيد لشكلها.
  /// غيابها يعني «كل القواعد متوقّفة»: لا يُرسَل شيء بلا قرارٍ صريح من
  /// التاجر، فلا تفاجئ ترقيةٌ زبائنه برسائل لم يطلبها.
  automations                  Json?
  /// اسمٌ قصير لأيقونة التطبيق المثبَّت على الشاشة الرئيسية.
  ///
  /// الشاشة تعرض نحو ١٢ محرفاً ثمّ تقطع. وبلا هذا الحقل كان الاسم يُقتطع
  /// آلياً — فيظهر «مطعم أبو محم…» على هاتف الزبون. الاختيار للتاجر لأنه
  /// وحده يعرف أي جزءٍ من اسمه يميّزه.
  pwaShortName                 String?
  /// إعدادات محرّكات البحث والمشاركة لهذا النشاط وحده.
  ///
  /// `{ title, description, keywords, ogImage, favicon, noindex }` — كلها
  /// اختيارية؛ الفارغ يُشتقّ من الاسم والوصف والشعار كما كان. راجع
  /// services/seo.service.ts — هو المرجع الوحيد لشكلها وحدودها.
  ///
  /// **لماذا عمودٌ لكل نشاط لا إعدادٌ للمنصّة:** كل واجهةٍ صفحةٌ مستقلّة في
  /// نتائج البحث، وعنوانٌ واحد مشترك كان يجعل مئة متجرٍ تتنافس على
  /// «شام ستورز» بدل أن يظهر كلٌّ باسمه وما يبيعه.
  seoSettings                  Json?
  /// معرّفات أدوات التتبّع الإعلانية — `{ metaPixelId, tiktokPixelId, ga4Id }`.
  /// راجع services/tracking.service.ts — المرجع الوحيد لصيغها واستحقاقها.
  trackingSettings             Json?
  /// الظهور في «سوق شام ستورز» — الدليل العامّ على /souq.
  ///
  /// **`null` يعني «الافتراضي» لا «لا»:** كل نشاطٍ ظاهرٌ ما لم يُطفئه التاجر
  /// صراحةً. ولو كان الافتراضي مخفيّاً لبقي السوق فارغاً — فالتاجر لا يعرف
  /// بالخيار حتى يرى زبوناً جاءه منه. راجع services/souq.service.ts.
  souqListed                   Boolean?
  /// رمز المحافظة من config/syria.ts — لا اسمها، كي لا يكسر التطبيع المطابقة
  souqGovernorate              String?
  /// تصنيف النشاط في السوق — رمزٌ من config/souq.ts
  souqCategory                 String?
  subscriptionStart            DateTime?
  subscriptionEnd              DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  // Relations
  plan       Plan       @relation(fields: [planId], references: [id])
  owner      User?      @relation("RestaurantOwner", fields: [userId], references: [id])
  users      User[]     @relation("RestaurantUsers")
  categories Category[]
  menuItems  MenuItem[]
  tables     Table[]
  orders     Order[]
  coupons    Coupon[]
  tickets    Ticket[]

  @@index([planId])
  @@index([slug])
}

model Store {
  id                      String  @id @default(cuid())
  planId                  String
  name                    String
  slug                    String  @unique
  email                   String?
  phone                   String?
  userId                  String? // owner can have multiple stores
  address                 String?
  description             String?
  /// الاسم والوصف بالإنجليزية — يظهران حين يبدّل الزبون اللغة.
  ///
  /// **كانا غائبين تماماً:** بُني زرّ اللغة وترجمة الواجهة، وبقي اسم المتجر
  /// ووصفه عربيّين مهما بدّل الزبون — لأنه لا حقل يحملهما. الفراغ يرتدّ إلى
  /// العربية، فمن لم يترجم لا يخسر شيئاً.
  nameEn                       String?
  descriptionEn                String?
  logo                    String?
  coverImage              String?
  latitude                Float?
  longitude               Float?
  showAllBranchesProducts Boolean @default(false)
  // لوحة هوية شام ستورز — أخضر داكن وليموني، كواجهة القائمة الرقمية.
  //
  // الفرق بين المتجر والقائمة في **الهيكل** لا في اللون: شريط علوي دائم
  // وبانر عريض وشبكة منتجات مقابل غلاف وقائمة صفوف. لونان مختلفان كانا
  // سيجعلان المنصة تبدو منصتين لا منتجين لمنصة واحدة.
  //
  // (وكان الافتراضي قبلهما خلفية بيضاء ونصاً أسود مع بطاقات وأسطح داكنة —
  // لوحة نصفها فاتح ونصفها داكن، أي نصٌّ رمادي على أبيض وبطاقات سوداء.)
  primaryColor            String  @default("#084835")
  secondaryColor          String  @default("#C07CDF")
  backgroundColor         String  @default("#F6F8F5")
  textColor               String  @default("#10231B")
  cardColor               String  @default("#FFFFFF")
  surfaceColor            String  @default("#EEF3EF")
  mutedColor              String  @default("#647870")
  accentColor             String  @default("#084835")
  fontFamily              String  @default("Cairo")

  /// شكل واجهة المتجر — انظر التعليق نفسه على Restaurant.
  storefrontDesign        Json?
  timezone                String  @default("Asia/Riyadh")
  currency                String  @default("SYP")
  language                String  @default("ar")

  whatsapp  String?
  instagram String?
  facebook  String?
  tiktok    String?

  deliverySettings     Json?
  paymentSettings      Json?
  /// خيارات إتمام الطلب — نفس بنية المطعم (services/checkoutExtras.service.ts)
  checkoutSettings     Json?
  notificationSettings Json?
  /// اللغات المفعّلة في واجهة الزبون — نفس قواعد المطعم
  enabledLanguages     Json?
  /// عملات العرض المفعّلة، مثل ["SYP"] أو ["SYP","USD"].
  /// الأسعار تُخزَّن بالليرة دائماً؛ هذه عملات **عرض** لا تخزين، والدولار
  /// منها يتطلّب سعر صرف مضبوطاً من السوبر أدمن — راجع services/currency.service.ts
  enabledCurrencies    Json?
  /// التسعير بالدولار — نفس حقول المطعم وقواعده، راجع services/usdPricing.service.ts
  pricingCurrency        String    @default("SYP")
  usdRateSource          String    @default("platform")
  customUsdRate          Float?
  customUsdRateUpdatedAt DateTime?
  priceRoundingStep      Float     @default(0)
  /// إعدادات الرسائل التلقائية.
  ///
  /// `{ lapsed: { enabled, afterDays, title, body }, abandonedCart: { … } }`
  /// راجع services/automation.service.ts — هو المرجع الوحيد لشكلها.
  /// غيابها يعني «كل القواعد متوقّفة»: لا يُرسَل شيء بلا قرارٍ صريح من
  /// التاجر، فلا تفاجئ ترقيةٌ زبائنه برسائل لم يطلبها.
  automations                  Json?
  /// اسمٌ قصير لأيقونة التطبيق المثبَّت على الشاشة الرئيسية.
  ///
  /// الشاشة تعرض نحو ١٢ محرفاً ثمّ تقطع. وبلا هذا الحقل كان الاسم يُقتطع
  /// آلياً — فيظهر «مطعم أبو محم…» على هاتف الزبون. الاختيار للتاجر لأنه
  /// وحده يعرف أي جزءٍ من اسمه يميّزه.
  pwaShortName                 String?
  /// إعدادات محرّكات البحث والمشاركة — انظر التعليق نفسه على Restaurant.
  seoSettings                  Json?
  /// معرّفات أدوات التتبّع الإعلانية — انظر التعليق نفسه على Restaurant.
  trackingSettings             Json?
  /// الظهور في «سوق شام ستورز» — انظر التعليق نفسه على Restaurant.
  souqListed                   Boolean?
  souqGovernorate              String?
  souqCategory                 String?

  subdomain                    String    @unique
  customDomain                 String?   @unique
  customDomainVerified         Boolean?  @default(false)
  customDomainVerifiedAt       DateTime?
  customDomainVerificationCode String?   @unique
  /// معرّف Custom Hostname في Cloudflare — به نقرأ الحالة ونحذف عند فكّ الربط
  customDomainHostnameId       String?
  /// «تاجر موثّق»: متى وافق المشرف على هوية صاحب النشاط. `null` = غير موثّق.
  /// تاريخٌ لا عَلَم: يقول متى تحقّقنا، ويُمسح عند سحب التوثيق.
  verifiedAt                   DateTime?
  /// حالة النطاق عند Cloudflare: pending / active / blocked …
  customDomainStatus           String?
  /// حالة شهادة TLS — النطاق لا يعمل على https قبل أن تصبح active
  customDomainSslStatus        String?
  /// آخر مزامنة مع Cloudflare
  customDomainCheckedAt        DateTime?
  /// آخر خطأ تحقّق، يُعرض للتاجر لأن سببه في إعداد نطاقه
  customDomainError            String?   @db.Text

  isActive          Boolean   @default(true)
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // ✅ العلاقات - تم إصلاحها
  plan       Plan       @relation(fields: [planId], references: [id])
  owner      User?      @relation("StoreOwner", fields: [userId], references: [id])
  users      User[]     @relation("StoreUsers")
  categories Category[]
  products   Product[]
  orders     Order[]
  coupons    Coupon[]
  drivers    Driver[]
  tickets    Ticket[]

  @@index([planId])
  @@index([slug])
}

model Category {
  id            String   @id @default(cuid())
  storeId       String?
  restaurantId  String?
  name          String
  nameEn        String?
  description   String?
  descriptionEn String?
  image         String?
  position      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  /// التصنيف الأب — فارغٌ يعني تصنيفاً رئيسياً.
  ///
  /// **مستويان لا شجرةٌ مفتوحة:** العمق الحرّ يعني شريط أقسامٍ لا يُرسم
  /// على شاشة جوال، ومسارَ تصفّحٍ يضيع فيه الزبون. والقاعدة مفروضةٌ في
  /// المتحكّم: من له أبٌ لا يصير أباً.
  parentId String? @map("parent_id")

  store      Store?      @relation(fields: [storeId], references: [id])
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
  products   Product[]
  menuItems  MenuItem[]
  parent     Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[]  @relation("CategoryTree")

  @@index([parentId])
}

model MenuItem {
  id              String   @id @default(cuid())
  restaurantId    String
  categoryId      String?
  name            String
  nameEn          String?
  /// رمز الصنف للكاشير — يُمسح بالباركود.
  ///
  /// اختياريّ ومفهرس لا فريد عالمياً: المطعم يبيع مشروبات وعبوات جاهزة لها
  /// باركود مطبوع، ووجباتٍ لا رمز لها. والتفرّد يُفحص داخل المطعم لا عبر
  /// المنصّة — رمزان متطابقان في مطعمين مختلفين ليسا تعارضاً.
  sku             String?
  description     String?
  descriptionEn   String?
  /// عنوان الصفحة لمحرّكات البحث — يكتبه التاجر أو مساعد الذكاء الاصطناعي.
  /// فارغٌ يعني «اسم الصنف | اسم المطعم» كما كان.
  seoTitle        String?  @map("seo_title")
  price           Float
  originalPrice   Float?
  /// السعر بالدولار حين يسعّر المطعم بالدولار — `price` يُشتقّ منه بسعر الصرف.
  /// `null` يعني صنفاً مسعّراً بالليرة مباشرة. لا يُقسَم عند إعادة التقويم.
  priceUsd         Float?
  originalPriceUsd Float?
  /// صورة الغلاف — مشتقة من images[0]، أُبقيت للتوافق مع القراءات القائمة.
  image           String?
  /// مصفوفة روابط الصور. الغلاف أولها.
  images          Json?
  /// خيارات يختارها الزبون قبل الطلب: لون، مقاس، إضافات…
  /// مصفوفة مجموعات: { name, type: single|multi, required, values: [{label, priceDelta}] }
  /// راجع services/productOptions.service.ts — هو المرجع الوحيد لشكلها وتحقّقها.
  options         Json?
  /// هل يُتتبَّع مخزون هذا الصنف؟
  ///
  /// **اختياريّ لكل صنف لا للمطعم كلّه.** الشاورما تُحضَّر عند الطلب فلا
  /// مخزون لها، وعلبة البيبسي لها عدد. ولو تُتبِّع الجميع لظهرت كل الوجبات
  /// «نفدت» فور التفعيل — وهو ما يوقف المطعم عن البيع في دقيقة.
  trackStock      Boolean  @default(false) @map("track_stock")

  /// الكمية المتبقّية — ذات معنى فقط حين `trackStock`.
  ///
  /// `null` يعني «لا يُتتبَّع» والصفر يعني «نفد». وخلطهما هو بالضبط ما يجعل
  /// كل أصناف المطعم تبدو نافدة.
  stock           Int?

  minStockLevel   Int?     @default(5) @map("min_stock_level")

  isAvailable     Boolean  @default(true)
  isPopular       Boolean  @default(false)
  isNew           Boolean  @default(false)
  preparationTime Int?     @default(0)
  position        Int      @default(0)
  ordersCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  category   Category?   @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  comments   ItemComment[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([restaurantId, sku])
}

model Product {
  id            String   @id @default(cuid())
  storeId       String
  name          String
  nameEn        String?
  /// رمز المنتج للكاشير — يُمسح بالباركود.
  ///
  /// **فريدٌ داخل المتجر لا عبر المنصّة:** كان `@unique` عالمياً، وباركود
  /// EAN المطبوع على العبوة واحدٌ في العالم كلّه — فمتجرٌ سجّل باركود
  /// «بيبسي» كان يمنع كلّ متجرٍ آخر من استعماله، وهو متجرٌ لا يراه ولا
  /// يعرف بوجوده. التفرّد في `@@unique([storeId, sku])` أسفل النموذج.
  sku           String
  description   String?
  /// الوصف بالإنجليزية — يرتدّ إلى العربي حين يكون فارغاً
  descriptionEn String?
  /// عنوان صفحة المنتج لمحرّكات البحث — فارغٌ يعني «اسم المنتج | اسم المتجر»
  seoTitle      String?  @map("seo_title")
  price         Float
  /// السعر قبل التخفيض. أعلى من price يعني عرضاً؛ مساوٍ أو أقل يُتجاهَل.
  originalPrice Float?
  /// السعر بالدولار حين يسعّر المتجر بالدولار — `price` يُشتقّ منه بسعر الصرف.
  /// `null` يعني منتجاً مسعّراً بالليرة مباشرة. لا يُقسَم عند إعادة التقويم.
  priceUsd         Float?
  originalPriceUsd Float?
  cost          Float?
  stock         Int      @default(0)
  reservedStock Int      @default(0)
  minStockLevel Int      @default(5)
  maxStockLevel Int?
  /// صورة الغلاف — تبقى مشتقة من images[0]. لم تُستبدل لأن 131 موضعاً
  /// يقرأها، واستبدالها دفعةً واحدة مخاطرة بلا مقابل.
  imageUrl      String?
  /// مصفوفة روابط الصور. الغلاف أولها.
  images        Json?
  categoryId    String?

  /// وسومٌ حرّة يفرز بها الزبون — مصفوفة نصوص.
  ///
  /// **عمودٌ لا جدول:** الوسم هنا كلمةٌ لا كيان — لا وصف له ولا صورة ولا
  /// ترتيب. والتصفية تجري في الواجهة حيث المنتجات محمَّلة أصلاً، فجدولُ
  /// وصلٍ يضيف انضماماً في كل استعلامٍ بلا مقابل. وقائمة وسوم المتجر
  /// تُشتقّ من منتجاته.
  ///
  /// ويصير جدولاً يوم يحتاج الوسم صورةً أو إعادةَ تسميةٍ بضغطة — لا قبله.
  tags          Json?
  /// خيارات يختارها الزبون قبل الطلب — راجع services/productOptions.service.ts
  options       Json?
  isAvailable   Boolean  @default(true)
  /// «قريباً» — يُعرض في المتجر ولا يُطلب بعد، ويجمع طلبات «أعلمني».
  ///
  /// منفصلٌ عن `isAvailable`: الموقوف مخفيّ، والقادم ظاهرٌ عمداً — التاجر
  /// يريد أن يعرف الزبائن أنه في الطريق، ويعرف هو كم ينتظره قبل أن يطلبه.
  comingSoon    Boolean  @default(false) @map("coming_soon")
  /// موعد التوفّر المتوقّع إن عرفه التاجر — يُعرض «يتوفّر في …»
  availableAt   DateTime? @map("available_at")
  /// عربونٌ يُدفع مسبقاً لهذا المنتج: `percent` من سعر السطر أو `fixed` لكل
  /// قطعة. `null` = بلا عربون. المبلغ يحسبه الخادم عند الطلب لا الواجهة.
  depositType   String?  @db.VarChar(10)
  depositValue  Float?
  unit          String   @default("piece")
  sortOrder     Int      @default(0)
  /// يرفعه التاجر يدوياً — تناظراً مع MenuItem
  isPopular     Boolean  @default(false)
  /// عدّاد مبيعات يُغذّي تصنيف «الرائج» بلا تدخّل يدوي
  ordersCount   Int      @default(0)
  /// متوسّط التقييم وعدده — محفوظان لا محسوبان عند القراءة: صفحة فيها مئة
  /// منتج كانت ستُطلق مئة استعلام تجميع في كل زيارة.
  ratingAvg     Float    @default(0)
  ratingCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  store      Store               @relation(fields: [storeId], references: [id])
  category   Category?           @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  movements  InventoryMovement[]
  reviews    ProductReview[]
  stockAlerts StockAlert[]
  comments   ItemComment[]

  @@unique([storeId, sku])
}

/// تقييم زبونٍ لصنفٍ اشتراه.
///
/// **لماذا جدول مستقلّ عن `Order.rating`:** تقييم الطلب يقول «كانت التجربة
/// جيدة»، ولا يقول أي صنفٍ استحقّها. والزبون الذي يفكّر بالشراء يسأل عن
/// المنتج لا عن الطلب — فتقييمٌ لا ينزل إلى مستوى المنتج لا يُعرض له أصلاً،
/// ويضيع أثره على قرار الشراء كلّه.
///
/// **ولا يُقبل تقييم إلا من مشترٍ:** `orderId` مطلوب، والقيد المركّب يمنع
/// تقييمين لنفس المنتج من نفس الطلب. بدونه تمتلئ الصفحة بتقييماتٍ لا شراء
/// خلفها، فتفقد قيمتها كإشارة.
model ProductReview {
  id        String @id @default(cuid())
  productId String @map("product_id")
  /// المشتري. الطلبات الضيفية بلا حساب لا تُقيَّم — لا سبيل للتحقّق منها.
  userId    String @map("user_id")
  /// الطلب الذي اشتُري فيه — إثبات الشراء
  orderId   String @map("order_id")

  rating  Int
  comment String? @db.Text

  /// يخفيه التاجر دون حذفه — الحذف يُخفي الإساءة ويُخفي معها الدليل
  isHidden Boolean @default(false) @map("is_hidden")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
  @@index([productId, isHidden, createdAt])
  @@index([userId])
  @@map("product_reviews")
}

/// طلب «أعلمني حين يتوفّر» — لمنتجٍ نافد أو قادم.
///
/// **بريدٌ أو هاتفٌ أو حسابٌ مسجَّل:** زبون المتجر ليس دائماً مسجَّلاً، ومطالبته
/// بحسابٍ ليعرف موعد عودة منتجٍ تُضيّعه. والتاجر يرى العدد والجهات في لوحته
/// فيعرف الطلب الحقيقي قبل أن يعيد التوريد.
///
/// `notifiedAt` يُملأ حين يعود المنتج: الطلب يُنفَّذ مرّةً واحدة ولا يُعاد.
model StockAlert {
  id        String    @id @default(cuid())
  productId String    @map("product_id")
  storeId   String    @map("store_id")
  userId    String?   @map("user_id")
  name      String?
  email     String?
  phone     String?
  notifiedAt DateTime? @map("notified_at")
  createdAt DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, notifiedAt])
  @@index([storeId, createdAt])
  @@map("stock_alerts")
}

model InventoryMovement {
  id            String   @id @default(cuid())
  productId     String
  quantity      Int
  type          String
  reason        String?
  referenceId   String?
  referenceType String?
  createdAt     DateTime @default(now())

  // Relations
  product Product @relation(fields: [productId], references: [id])
}

model Order {
  id                     String             @id @default(cuid())
  restaurantId           String?
  storeId                String?
  tableId                String?
  orderNumber            String             @unique
  customerName           String?
  customerPhone          String?
  status                 OrderStatus        @default(pending)
  total                  Float
  /// سعر الصرف (ليرة/دولار) الذي حُسبت به أسعار الأصناف المسعّرة بالدولار
  /// لحظة الطلب. `null` لطلبٍ كلّه بالليرة — المبالغ نفسها بالليرة دائماً.
  exchangeRate           Float?
  subtotal               Float?             @default(0)
  discountAmount         Float?             @default(0)
  couponCode             String?
  notes                  String?
  paymentMethod          PaymentMethod      @default(cash)
  isPaid                 Boolean            @default(false)
  tax                    Float              @default(0)
  createdBy              String?
  orderType              OrderType          @default(dine_in)
  deliveryAddress        String?
  deliveryLat            Float?
  deliveryLng            Float?
  assignedDriverId       String?
  estimatedDeliveryTime  Int?
  actualDeliveryTime     Int?
  deliveryFee            Float?             @default(0)
  /// محافظة التسليم — أساسُ حساب الأجرة وقرارِ السائق أو الشحن
  governorate            String?
  deliveryDistance       Float?
  driverAcceptedAt       DateTime?
  driverReachedAt        DateTime?
  paymentCollectedAt     DateTime?
  /// المرتجع لا يُلغي الطلب ولا يغيّر حالته: البضاعة سُلّمت فعلاً ثم عادت.
  /// دمجه في `status` كان سيمحو أن التسليم حدث، وهو ما يميّز المرتجع عن
  /// الإلغاء في أي دفتر حسابات.
  affiliateReferral      AffiliateReferral?
  returnedAt             DateTime?
  /// المبلغ المُعاد — قد يكون جزءاً من الطلب لا كلّه
  returnAmount           Float?
  returnReason           String?            @db.Text
  rating                 Int?               @default(0)
  ratingComment          String?
  ratedAt                DateTime?
  orderSource            String             @default("restaurant")
  /// مفتاح عدم التكرار — يولّده جهاز الكاشير قبل الإرسال. بيعةٌ أُرسلت
  /// على شبكةٍ ضعيفة ثم أُعيدت من طابور «دون اتصال» تُسجَّل مرّةً واحدة.
  /// نسخةٌ للقراءة فقط: التفرّد يحرسه `PosSaleKey` — قيدٌ فريد على جدول
  /// الطلبات القائم يوقف `db push` في الإنتاج بتحذير «فقدان بيانات».
  idempotencyKey         String?            @db.VarChar(64)
  /// متى بيعت فعلاً على الجهاز إن وصلت لاحقاً من طابور «دون اتصال»
  offlineSoldAt          DateTime?
  /// بيعت دون اتصال والرصيد لم يكفِ عند المزامنة — تُقبل ويُرفع العلَم
  /// للمراجعة بدل رفض بيعةٍ قبض الكاشير ثمنها فعلاً
  stockShortage          Boolean            @default(false)
  /// العنوان المنظَّم كما اختاره الزبون: المحافظة والمنطقة وأقرب نقطة دالّة
  /// والبناء والطابق، مع لقطةٍ من اسم المنطقة وأجرتها لحظة الطلب.
  ///
  /// **JSON بجانب `deliveryAddress` لا بديلاً عنه:** تطبيق السائق والطباعة
  /// والطلبات القديمة كلّها تقرأ النصّ، فيبقى النصّ مركّباً من هذه الحقول.
  /// راجع services/deliveryArea.service.ts
  deliveryDetails        Json?
  deliveryProofImage     String?
  deliveryProofSignature String?
  deliveryProofType      String?
  proofTakenAt           DateTime?
  driverRating           Int?
  driverRatingComment    String?
  driverRatedAt          DateTime?
  // ─── إضافات إتمام الطلب — راجع services/checkoutExtras.service.ts ───
  /// «معاينة قبل الدفع»: لقطةٌ من إعداد التاجر لحظة الطلب — يقرؤها السائق.
  /// لقطة لا قراءةٌ حيّة: تاجرٌ يطفئ الخيار غداً لا يُسقط وعداً قُطع لزبون اليوم.
  inspectionAllowed      Boolean            @default(false)
  /// «اشترِ لأهلك»: الدافع خارج سوريا والمستلم داخلها. المستلم هو
  /// `customerName`/`customerPhone`/`deliveryAddress` — كل ما يقرأ الطلب
  /// (السائق والطباعة والتتبّع) يصل إليه بلا تغيير.
  isGift                 Boolean            @default(false)
  giftPayerName          String?            @db.VarChar(120)
  giftPayerPhone         String?            @db.VarChar(32)
  giftPayerEmail         String?            @db.VarChar(160)
  giftMessage            String?            @db.Text
  /// لا أسعار على ملصق المستلم ولا في صفحة تتبّعه
  giftHidePrices         Boolean            @default(false)
  /// حالة الدفع المسبق — منفصلة عن `status` عمداً: `awaiting_transfer` يعني
  /// أن الطلب لا يُجهَّز حتى يؤكّد التاجر وصول التحويل، ثم `confirmed`.
  /// `null` لطلبٍ عاديّ لا دفع مسبقاً فيه.
  paymentStatus          String?            @db.VarChar(24)
  paymentConfirmedAt     DateTime?
  /// العربون: يحسبه الخادم من منتجات الطلب. المتبقّي = الإجمالي − العربون،
  /// ويُحصَّل عند التسليم أو بالأقساط.
  depositAmount          Float?
  depositPaidAt          DateTime?
  remainingAmount        Float?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  // Relations
  restaurant    Restaurant?      @relation(fields: [restaurantId], references: [id])
  store         Store?           @relation(fields: [storeId], references: [id])
  table         Table?           @relation(fields: [tableId], references: [id])
  /// السائق المعيَّن — **مستخدم** لا صفّ `Driver`.
  ///
  /// كانت العلاقة تشير إلى `Driver.id` بينما تكتب الشيفرة كلّها (٤٦ موضعاً)
  /// معرّف المستخدم: `assignDeliveryDriver` يبحث في `user` ثم يكتب معرّفه،
  /// و`getDriverOrders` يقارن بـ`req.user.id`. والمفتاح الأجنبي كان يرفض
  /// ذلك، فيرتدّ كل تعيين سائق بخطأ قيد — أي أن التوصيل لم يعمل قطّ.
  /// (صفر طلب معيَّن في الإنتاج يؤكّده.)
  driver        User?            @relation("AssignedDeliveries", fields: [assignedDriverId], references: [id])
  creator       User?            @relation("CreatedOrders", fields: [createdBy], references: [id])
  coupon        Coupon?          @relation(fields: [couponCode], references: [code])
  items         OrderItem[]
  driverEarning DriverEarning?
  deliveries    DriverDelivery[]
  installments  OrderInstallment[]
  saleKey       PosSaleKey?

  @@index([restaurantId])
  @@index([storeId])
  @@index([assignedDriverId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
}

/// قسطٌ من جدول تقسيط يضعه التاجر لطلبٍ بعينه — يدويّ بالكامل: التاجر يحدّد
/// المبالغ والمواعيد، ويعلّم كلّ قسطٍ مدفوعاً حين يستلمه. لا تحصيل آليّ.
/// مفتاح عدم تكرار بيعة الكاشير — جدولٌ مستقلّ كي يُنشأ قيده الفريد مع
/// الجدول نفسه بلا بيانات قديمة يُحذَّر منها. يُكتب داخل معاملة البيعة، فإن
/// سبقه مفتاحٌ مطابق (P2002) سقطت البيعة المكرّرة كاملةً.
model PosSaleKey {
  key       String   @id @db.VarChar(64)
  orderId   String   @unique @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("pos_sale_keys")
}

model OrderInstallment {
  id        String    @id @default(cuid())
  orderId   String
  seq       Int
  dueDate   DateTime
  amount    Float
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String?
  productId  String?
  quantity   Int      @default(1)
  price      Float
  /// تكلفة الوحدة **لحظة البيع**.
  ///
  /// حسابها من `Product.cost` الحالي يجعل أرباح الشهر الماضي تتغيّر كلّما
  /// عدّل التاجر سعر الشراء — تقرير مالي يعيد كتابة تاريخه ليس تقريراً.
  /// وتبقى فارغة في الطلبات القديمة، فتُقرأ عندها من المنتج مع تعليم
  /// التقدير في الواجهة.
  cost       Float?
  /// سعر الوحدة بالدولار لحظة البيع إن كان الصنف مسعّراً بالدولار
  priceUsd   Float?
  size       String?
  addons     Json?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  order    Order     @relation(fields: [orderId], references: [id])
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id])
  product  Product?  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([menuItemId])
  @@index([productId])
}

/// أجرة التوصيل أو الشحن لمحافظة واحدة.
///
/// **صفٌّ لكل محافظة لا رقمٌ واحد للمتجر:** كان `deliveryFee` رقماً وحيداً،
/// فتاجرٌ في دمشق يبيع إلى حلب لا يستطيع تسعير الفرق — فيضع رقماً وسطاً
/// يخسر به في البعيد ويخسر الزبون في القريب.
model ShippingZone {
  id           String @id @default(cuid())
  businessId   String @map("business_id")
  /// restaurant | store
  businessType String @map("business_type")

  /// رمز المحافظة — راجع config/syria.ts، وهو المرجع الوحيد للقائمة
  governorate String

  fee Float @default(0)

  /// شحنٌ مجانيّ فوق هذا المبلغ. `null` يعني «لا شحن مجاني».
  ///
  /// والصفر ليس بديلاً عن `null`: صفرٌ يعني «كل الطلبات مجانية» وهو قرارٌ
  /// مختلف تماماً.
  freeOverAmount Float? @map("free_over_amount")

  /// مدّة التسليم المتوقّعة بالأيام — تُعرض للزبون قبل الدفع
  estimatedDays Int? @map("estimated_days")

  /// `driver` يُسنَد لسائق المتجر، و`shipping` لشركة شحن.
  ///
  /// **هذا ما يمنع إسناد طلب حلبَ إلى سائقٍ في دمشق.** والقرار للتاجر لا
  /// للنظام: قد يكون له سائقٌ في محافظتين.
  deliveryMode String @default("shipping") @map("delivery_mode")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, businessType, governorate])
  @@index([businessId, businessType, isActive])
  @@map("shipping_zones")
}

model Coupon {
  id             String    @id @default(cuid())
  storeId        String?
  restaurantId   String?
  code           String    @unique
  discountType   String
  discountValue  Float
  minOrderAmount Float?
  startDate      DateTime  @default(now())
  endDate        DateTime?
  usageLimit     Int?
  usageCount     Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  store      Store?      @relation(fields: [storeId], references: [id])
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
  orders     Order[]     @relation
}

model Table {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  nameEn       String?
  seats        Int      @default(2)
  qrCode       String?
  sortOrder    Int      @default(0)
  qrSvg        String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  orders     Order[]

  @@index([restaurantId])
}

model Ticket {
  id           String   @id @default(cuid())
  userId       String
  restaurantId String?
  storeId      String?
  subject      String
  description  String?
  status       String   @default("open")
  priority     String   @default("medium")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user       User        @relation(fields: [userId], references: [id])
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
  store      Store?      @relation(fields: [storeId], references: [id])

  @@index([userId])
  @@index([restaurantId])
  @@index([storeId])
}

model Driver {
  id                 String    @id @default(cuid())
  userId             String
  storeId            String?
  vehicleType        String?
  vehiclePlate       String?
  licenseNumber      String?
  hourlyRate         Float     @default(0)
  baseSalary         Float     @default(0)
  isActive           Boolean   @default(true)
  isOnline           Boolean   @default(false)
  currentLat         Float?
  currentLng         Float?
  lastLocationUpdate DateTime?
  lastActiveAt       DateTime?
  totalDeliveries    Int       @default(0)
  rating             Float     @default(5.0)
  totalEarnings      Float     @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  user       User             @relation(fields: [userId], references: [id])
  store      Store?           @relation(fields: [storeId], references: [id])
  earnings   DriverEarning[]
  shifts     DriverShift[]
  deliveries DriverDelivery[]
}

model DriverDelivery {
  id             String    @id @default(cuid())
  driverId       String
  orderId        String
  status         String    @default("assigned")
  acceptedAt     DateTime?
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  earnings       Float?    @default(0)
  proofImage     String?
  customerRating Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  driver Driver @relation(fields: [driverId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@index([driverId])
  @@index([orderId])
  @@index([status])
}

model DriverLocationHistory {
  id         String   @id @default(cuid())
  driverId   String
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())

  @@index([driverId])
  @@index([recordedAt])
}

model DriverEarning {
  id          String    @id @default(cuid())
  driverId    String
  orderId     String    @unique
  amount      Float
  type        String
  description String?
  status      String    @default("pending")
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  // Relations
  driver Driver @relation(fields: [driverId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])
}

model DriverShift {
  id        String    @id @default(cuid())
  driverId  String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  duration  Int?
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  driver Driver @relation(fields: [driverId], references: [id])
}

// ==================== باقي النماذج (بدون تغيير) ====================

model Advertisement {
  id               String    @id @default(cuid())
  title            String
  titleEn          String?
  description      String?   @db.Text
  descriptionEn    String?   @db.Text
  imageUrl         String
  linkUrl          String?
  position         Int       @default(0)
  isActive         Boolean   @default(true)
  startAt          DateTime?
  endAt            DateTime?
  price            Float     @default(0)
  paid             Boolean   @default(false)
  paymentReference String?
  clientName       String?
  clientEmail      String?
  clientPhone      String?
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([isActive])
  @@index([startAt, endAt])
  @@index([position])
}

model Image {
  id                String   @id @default(cuid())
  userId            String?  @map("user_id")
  businessType      String   @map("business_type")
  businessId        String?  @map("business_id")
  uploadType        String?  @map("upload_type")
  subType           String?  @map("sub_type")
  provider          String   @default("cloudflare")
  imageUrl          String   @map("image_url")
  cloudflareImageId String?  @map("cloudflare_image_id")
  originalName      String?  @map("original_name")
  mimeType          String?  @map("mime_type")
  sizeBytes         Int?     @map("size_bytes")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([businessType, businessId])
  @@index([uploadType, subType])
  @@index([userId])
  @@map("images")
}

model Subscription {
  id               String    @id @default(cuid())
  businessType     String
  businessId       String
  planId           String
  planName         String
  months           Int
  price            Float
  discount         Float     @default(0)
  totalPaid        Float
  startDate        DateTime
  endDate          DateTime
  status           String    @default("active")
  paymentMethod    String
  paymentReference String?
  notes            String?
  reminderSent     Boolean   @default(false)
  reminderSentAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // ✅ أضف هذه العلاقات
  // restaurant       Restaurant? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // store            Store?      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessType, businessId])
  @@index([status])
  @@index([endDate])
}

model MarketingSection {
  id            String       @id @default(cuid())
  businessType  BusinessType
  businessId    String
  sectionType   String
  title         String?
  titleEn       String?
  description   String?
  descriptionEn String?
  imageUrl      String?
  linkUrl       String?
  isActive      Boolean      @default(true)
  sortOrder     Int          @default(0)
  startAt       DateTime?
  endAt         DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([businessType, businessId])
}

model MarketingSettings {
  id           String       @id @default(cuid())
  businessType BusinessType
  businessId   String       @unique
  sectionOrder Json         @default("[\"announcement\", \"banner\", \"offer\"]")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([businessType, businessId])
}

model PlatformSetting {
  id              String       @id @default(cuid())
  key             String       @unique
  value           String       @db.Text
  type            SettingType  @default(string)
  group           SettingGroup @default(general)
  description     String?
  isPublic        Boolean      @default(false)
  contactPhone    String?
  contactWhatsapp String?
  contactEmail    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([key])
  @@index([group])
}

model ExtendedPlatformSetting {
  id           String       @id @default(cuid())
  keyName      String       @unique
  value        String       @db.Text
  type         SettingType  @default(string)
  settingGroup SettingGroup @default(general)
  description  String?
  isPublic     Boolean      @default(false)
  isEditable   Boolean      @default(true)
  validation   Json?
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([keyName])
  @@index([settingGroup])
  @@index([settingGroup, keyName])
}

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String               @db.Text
  status    ContactMessageStatus @default(new)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

// Auth Configuration Settings stored in ExtendedPlatformSetting table
// Email Verification settings:
// - requireEmailVerification: (boolean) whether email verification is required on signup
// 
// SMTP settings:
// - smtpHost: (string) SMTP server hostname
// - smtpPort: (number) SMTP server port
// - smtpUser: (string) SMTP authentication username
// - smtpPassword: (string) SMTP authentication password (encrypted in production)
// - smtpFromEmail: (string) sender email address for verification emails
// - smtpTLS: (boolean) whether to use TLS/SSL
//
// Firebase settings:
// - firebaseProjectId: (string) Firebase project ID
// - firebaseApiKey: (string) Firebase API key
// - firebaseAuthDomain: (string) Firebase authentication domain
// - firebaseStorageBucket: (string) Firebase storage bucket
// - firebaseMessagingSenderId: (string) Firebase messaging sender ID
// - firebaseAppId: (string) Firebase app ID
// - firebaseServiceAccountKey: (json) Firebase service account key for backend auth

model UpgradeRequest {
  id              String    @id @default(cuid())
  userId          String
  restaurantId    String?
  storeId         String?
  currentPlanId   String
  requestedPlanId String
  status          String    @default("pending")
  reason          String?   @db.Text
  reviewedBy      String?
  reviewedAt      DateTime?
  requestedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model Feature {
  code           String   @id
  name           String
  nameEn         String?
  description    String?  @db.Text
  descriptionEn  String?  @db.Text
  category       String   @default("both")
  group          String   @default("basic")
  isCore         Boolean  @default(false)
  isActive       Boolean  @default(true)
  price          Float    @default(0)
  isOneTime      Boolean  @default(false)
  defaultInPlans Json?
  dependsOn      Json?
  configSchema   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
  @@index([category])
}

model BusinessFeature {
  id             String    @id @default(cuid())
  businessId     String
  businessType   String
  featureCode    String
  isEnabled      Boolean   @default(true)
  isOverridden   Boolean   @default(false)
  overrideReason String?   @db.Text
  overriddenBy   String?
  expiresAt      DateTime?
  config         Json?
  assignedBy     String?
  assignedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([businessId, businessType, featureCode])
  @@index([businessId, businessType])
  @@index([featureCode])
}

// طلب شراء ميزة مفردة.
//
// الميزات تُباع خارج الخطط: تاجر على المجانية قد يحتاج إخفاء شعار المنصة
// وحده، ولا معنى لدفعه ثمن خطة كاملة لأجله. وبلا هذا الجدول لم يكن للتاجر
// طريق إلى ميزة مفردة إطلاقاً — الإسناد يدوي من السوبر أدمن فقط.
//
// لا دفع إلكتروني: الطلب يُنشأ، ويتواصل السوبر أدمن، ثم يوافق فتُسند
// الميزة. نفس مسار طلبات الترقية.
model FeatureRequest {
  id           String    @id @default(cuid())
  userId       String
  businessId   String
  businessType String
  featureCode  String
  status       String    @default("pending")
  note         String?   @db.Text
  rejectReason String?   @db.Text
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([userId])
  @@index([businessId, businessType])
  @@index([featureCode])
}

model Setting {
  id          Int      @id @default(autoincrement())
  keyName     String   @unique
  value       String   @db.Text
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([keyName])
}

/// إشعارات المستخدمين.
///
/// البثّ عبر السوكِت وحده يضيع كلما كان المستخدم غير متصل — ولا يعرف بعده
/// أنه فاته شيء. التخزين هنا يجعل الإشعار حدثاً دائماً، والسوكِت مجرّد
/// وسيلة توصيل فوري له.
model Notification {
  id        String    @id @default(cuid())
  /// المستقبِل. للإشعارات الإدارية يُنشأ صفّ لكل مشرف.
  userId    String    @map("user_id")
  /// تصنيف: upgrade_request، order، ticket…
  type      String
  /// الحدث الدقيق: upgrade_request.created أو .approved
  event     String
  title     String
  message   String    @db.Text
  /// مسار تفتحه الواجهة عند النقر
  link      String?
  /// معرّف الكيان المرتبط
  entityId  String?   @map("entity_id")
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// الاستعلام الغالب: إشعارات مستخدم مرتّبة بالأحدث
  @@index([userId, isRead, createdAt])
  @@index([type])
  @@map("notifications")
}

/// حدثٌ واحد في واجهة متجرٍ — أساس تقارير الزيارات.
///
/// **لماذا جدول أحداثٍ خام لا عدّادات:** العدّاد يجيب سؤالاً واحداً عرفتَه
/// مسبقاً («كم زيارة؟»)، والتاجر يسأل ما لم نتوقّعه: أيّ منتجٍ يُشاهَد ولا
/// يُشترى؟ من أين يأتي من يشتري فعلاً؟ والحدثُ الخام يجيب هذه كلّها من
/// نفس الصفوف، والعدّاداتُ تُشتقّ منه لا العكس.
///
/// **ولا يُخزَّن ما يُعرِّف شخصاً:** لا IP ولا سلسلة متصفّح ولا كعكة.
/// `sessionId` رقمٌ عشوائيّ يعيش في تبويب الزائر وينتهي بإغلاقه — يكفي
/// لتمييز زيارةٍ من زيارة، ولا يتبع أحداً بين المتاجر ولا بين الأيام.
model StorefrontEvent {
  id String @id @default(cuid())

  /// restaurant | store
  businessType String @map("business_type")
  businessId   String @map("business_id")

  /// view_store | view_product | add_to_cart | begin_checkout | order_placed
  type String

  /// المنتج المعنيّ — لأحداث المشاهدة والإضافة إلى السلّة
  productId String? @map("product_id")

  /// **الزيارة لا التحميل:** معرّفٌ عشوائيّ لجلسة التبويب، فمن تنقّل بين
  /// عشر صفحات زيارةٌ واحدة لا عشر. بلا هذا يصير كلُّ تحديثٍ «زائراً».
  sessionId String @map("session_id")

  /// مضيف المُحيل بعد التطبيع: instagram.com أو whatsapp أو direct.
  /// المضيف وحده — لا المسار الكامل، فهو يحمل أحياناً معرّفاتٍ خاصّة.
  source String @default("direct")

  /// mobile | desktop
  device String @default("mobile")

  createdAt DateTime @default(now()) @map("created_at")

  /// الاستعلام الغالب: أحداثُ نشاطٍ في مدّة، مصنّفةً بالنوع
  @@index([businessId, businessType, createdAt])
  @@index([businessId, type, createdAt])
  /// لتقرير «الأكثر مشاهدةً» ولحذف أحداث منتجٍ حُذف
  @@index([productId])
  /// للحذف الدوريّ بالعمر
  @@index([createdAt])
  @@map("storefront_events")
}

/// تعليقٌ مفتوح على منتجٍ أو وجبة — نقاشٌ وأسئلة، لا تقييم.
///
/// **لماذا جدولٌ مستقلّ عن `ProductReview`:** التقييم إشارةٌ لا تُقبل إلا من
/// مشترٍ، لأن قيمتها في أنها مُثبَتة. أمّا التعليق فسؤالٌ قبل الشراء غالباً
/// («هل المقاس يطابق الجدول؟»، «هل فيها بصل؟») — حصرُه بالمشترين يُسكت
/// بالضبط من يحتاج الجواب. وخلطُهما في جدولٍ واحد كان سيُدخل أسئلةً بلا
/// نجوم في متوسّط التقييم أو يُلزم كلَّ سؤالٍ بنجمةٍ مصطنعة.
///
/// **منتجٌ أو وجبة، لا كلاهما:** `productId` للمتجر و`menuItemId` للمطعم،
/// ويُشترط في المتحكّم أن يُملأ أحدهما وحده. جدولٌ واحد لا اثنان لأن
/// شاشة الإشراف واحدة والقواعد (الطول، الروابط، الإخفاء) واحدة.
///
/// **`storeId`/`restaurantId` منسوخان عمداً بلا علاقة:** قائمة الإشراف تسأل
/// «كلّ تعليقات نشاطي» — وبلا النسخ يصير الاستعلام انضماماً عبر المنتج في
/// كلّ فتح. وتُركا أعمدةً مجرّدة كي لا يمسّ هذا الجدول نموذجَي النشاط.
///
/// **ردٌّ من مستوى واحد (`parentId`):** التاجر يجيب السؤال تحته مباشرة.
/// الشجرة العميقة تحوّل صفحة منتجٍ إلى منتدى، والزبون يريد الجواب لا الجدل.
model ItemComment {
  id              String  @id @default(cuid())
  productId       String? @map("product_id")
  menuItemId      String? @map("menu_item_id")
  storeId         String? @map("store_id")
  restaurantId    String? @map("restaurant_id")
  /// الزبون المسجَّل إن وُجد — الضيف يعلّق باسمه المكتوب وحده
  userId          String? @map("user_id")
  /// الاسم المعروض — منسوخٌ لا مشتقّ: تغيير الاسم لاحقاً أو حذف الحساب لا
  /// يُعيد كتابة نقاشٍ دار باسمٍ آخر
  authorName      String  @map("author_name") @db.VarChar(80)
  body            String  @db.Text
  /// التعليق الأصل إن كان هذا ردّاً — والأصل تعليقٌ علويّ دائماً
  parentId        String? @map("parent_id")
  /// ردّ النشاط نفسه — يُميَّز بشارة كي لا يلتبس بزبونٍ سمّى نفسه باسم المتجر
  isMerchantReply Boolean @default(false) @map("is_merchant_reply")
  /// يخفيه التاجر دون حذفه — كالتقييمات: الإخفاء يُبقي الدليل
  isHidden        Boolean @default(false) @map("is_hidden")
  /// عدّادا الإعجاب وعدمه — منسوخان من `ItemCommentReaction` ويُحدَّثان معها
  /// في المعاملة نفسها: القائمة تُرتَّب بهما وتعرضهما بلا تجميعٍ لكل صفحة
  likes           Int     @default(0)
  dislikes        Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product?              @relation(fields: [productId], references: [id], onDelete: Cascade)
  menuItem  MenuItem?             @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  user      User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent    ItemComment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ItemComment[]         @relation("CommentReplies")
  reactions ItemCommentReaction[]

  @@index([productId, isHidden, createdAt])
  @@index([menuItemId, isHidden, createdAt])
  @@index([storeId, createdAt])
  @@index([restaurantId, createdAt])
  @@index([parentId])
  @@index([userId])
  @@map("item_comments")
}

/// إعجاب زبونٍ بتعليقٍ أو عدمه — صفٌّ واحد لكل (تعليق، حساب).
///
/// **القيد الفريد هو الحارس:** نقرتان متزامنتان لا تصنعان صفّين، فلا يتضاعف
/// العدّاد. و`value` ‎+1 أو ‎-1؛ التبديل يغيّر القيمة، والإلغاء يحذف الصف.
///
/// **`userId` خامٌ بلا علاقة** مع `User` عمداً: العلاقة تضيف سطراً إلى نموذج
/// المستخدم المشترك بين فروعٍ كثيرة، والتحقّق يجري من الرمز لا من القاعدة.
model ItemCommentReaction {
  id        String   @id @default(cuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  value     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  comment ItemComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
  @@map("item_comment_reactions")
}

/// مرتجع الكاشير — مستندٌ مستقلّ لا تعديلٌ على البيعة.
///
/// **لماذا جدولٌ لا حقلٌ في الطلب:** البيعة الواحدة قد تُرجَع على دفعات (قطعةٌ
/// اليوم وأخرى بعد أسبوع)، ولكلّ دفعةٍ سببها وطريقة ردّ مالها وموظّفها
/// وإيصالها. و`Order.returnAmount` يبقى — مجموعاً يُحدَّث من هنا — لأن القسم
/// المالي يقرؤه ويطرحه من الصافي والربح، فلا حاجة لتعليمه مصدراً ثانياً.
///
/// **ومعرّفاتٌ خامّة بلا علاقات** مع الطلب والمنتج عمداً: إضافة علاقةٍ تعني
/// سطراً في نموذجَي `Order` و`Product`، وهما يُعدَّلان بالتوازي في فروعٍ أخرى.
/// والتحقّق من الانتماء يجري في المتحكّم قبل الكتابة على أيّ حال.
model PosReturn {
  id            String   @id @default(cuid())
  /// رقم الإيصال المطبوع — `RET-…` كما البيعة `POS-…`
  returnNumber  String   @unique @map("return_number")
  orderId       String   @map("order_id")
  /// منسوخٌ من البيعة: قائمة المرتجعات تُقرأ بلا ربطٍ بجدول الطلبات
  orderNumber   String   @map("order_number")
  storeId       String?  @map("store_id")
  restaurantId  String?  @map("restaurant_id")
  /// ما رُدّ للزبون — بعد توزيع خصم البيعة على أصنافها بالنسبة
  amount        Float
  /// cash | card | online | sham_cash — مطابقة الصندوق تحتاج النقد وحده
  refundMethod  String   @default("cash") @map("refund_method")
  reason        String?  @db.Text
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  items PosReturnItem[]

  @@index([storeId, createdAt])
  @@index([restaurantId, createdAt])
  @@index([orderId])
  @@map("pos_returns")
}

model PosReturnItem {
  id          String  @id @default(cuid())
  returnId    String  @map("return_id")
  /// سطر البيعة الأصل — به يُحسب «المُرجَع سابقاً» فلا يُرجَع أكثر ممّا بيع
  orderItemId String  @map("order_item_id")
  productId   String? @map("product_id")
  menuItemId  String? @map("menu_item_id")
  /// الاسم لحظة الإرجاع — المنتج قد يُحذف أو يُعاد تسميته والإيصال يبقى
  name        String
  quantity    Int
  /// سعر الوحدة في البيعة
  unitPrice   Float   @map("unit_price")
  /// ما رُدّ عن هذا السطر (بعد حصّته من الخصم)
  refund      Float
  /// أُعيد إلى المخزون — `false` لصنفٍ لا يُتتبَّع رصيده (وجبةٌ تُطبخ عند الطلب)
  restocked   Boolean @default(false)

  posReturn PosReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([orderItemId])
  @@map("pos_return_items")
}

/// طلب توثيق «تاجر موثّق».
///
/// **الوثائق لا تُحفظ كروابط عامة:** العمود يحمل مفتاحاً خاصّاً يقرؤه
/// `services/privateDocs.service.ts` وحده، ولا يُعرض الملف إلا للمشرف عبر
/// مسارٍ محروس. هوية التاجر ليست صورة منتج تُنشر على CDN.
model VerificationRequest {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  /// restaurant | store
  businessType String    @map("business_type")
  businessId   String    @map("business_id")
  legalName    String    @map("legal_name")
  tradeName    String?   @map("trade_name")
  phone        String
  address      String?   @db.Text
  /// هوية أو سجلّ تجاري — مفتاح تخزين خاص لا رابط
  documentKey  String    @map("document_key") @db.VarChar(512)
  documentMime String?   @map("document_mime")
  documentName String?   @map("document_name")
  shopPhotoKey  String?  @map("shop_photo_key") @db.VarChar(512)
  shopPhotoMime String?  @map("shop_photo_mime")
  /// pending | approved | rejected | revoked
  status       String    @default("pending")
  reason       String?   @db.Text
  reviewedBy   String?   @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([businessType, businessId])
  @@index([status, createdAt])
  @@map("verification_requests")
}

/// سجلّ استهلاك مساعد الذكاء الاصطناعي — سطرٌ لكل استدعاء.
///
/// **لماذا جدولٌ لا عدّادٌ في المتجر:** الحصّة نوعان — «مرّة واحدة» للمجانية
/// و«يومية» للمدفوعة — وكلاهما يُحسب بجمعٍ على نافذة زمنية. عدّادٌ واحد لا
/// يعرف متى صُرف ما صُرف، فيحتاج مهمّة تصفير ليلية تفشل بصمت يوماً ما.
///
/// والسطر يحمل النوع (`import` | `describe`) ووحداته: صورة محلَّلة للاستيراد،
/// ووصفٌ مكتوب للمساعد — فالتكلفة تُقاس بما يُرسَل للنموذج لا بما يُحفظ.
model AiUsage {
  id           String   @id @default(cuid())
  /// restaurant | store
  businessType String   @map("business_type")
  businessId   String   @map("business_id")
  userId       String?  @map("user_id")
  /// import | describe
  kind         String
  units        Int      @default(1)
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([businessType, businessId, kind, createdAt])
  @@map("ai_usage")
}

/// منطقةٌ أو حيٌّ داخل محافظة، بأجرتها — تحت `ShippingZone` لا بديلاً عنه.
///
/// **لماذا تُربط بالمحافظة لا بمعرّف صفّ المنطقة:** صفّ `ShippingZone` لا
/// يُنشأ إلا حين يحفظ التاجر المحافظات، وربطُ الأحياء به يفرض ترتيباً في
/// الحفظ يُفقد أحياءً كتبها التاجر قبل أن يضغط «حفظ المناطق».
///
/// وحين تملك المحافظة أحياءً مفعّلة تُسعَّر الطلبات بالحيّ؛ وإلا بقيت
/// بأجرة المحافظة كما كانت — فالمتاجر القائمة لا يتغيّر عليها شيء.
model DeliveryArea {
  id           String  @id @default(cuid())
  businessId   String  @map("business_id")
  /// restaurant | store
  businessType String  @map("business_type")
  /// رمز المحافظة من config/syria.ts
  governorate  String
  name         String  @db.VarChar(80)
  fee          Float   @default(0)
  /// توصيلٌ مجانيّ فوق هذا المبلغ. `null` = يُتبع حدّ المحافظة
  freeOverAmount Float? @map("free_over_amount")
  /// نصٌّ حرّ للزبون: «خلال ساعة»، «اليوم قبل المغرب»
  etaText      String? @map("eta_text") @db.VarChar(60)
  isActive     Boolean @default(true) @map("is_active")
  sortOrder    Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, businessType, governorate])
  @@map("delivery_areas")
}

/// مبلغٌ حصّله مندوبٌ نقداً عند التسليم — سطرٌ لكل طلب.
///
/// **المندوب مفتاحٌ نصّي لا علاقة:** قد يكون سائقاً في النظام
/// (`driver:<userId>`) أو «أبو محمد» الذي يوصّل للمحلّ منذ سنوات ولا حساب
/// له (`courier:<الاسم>`). والتسوية تجمع على المفتاح في الحالتين.
model CodCollection {
  id             String   @id @default(cuid())
  orderId        String   @unique @map("order_id")
  businessId     String   @map("business_id")
  businessType   String   @map("business_type")
  courierKey     String   @map("courier_key") @db.VarChar(120)
  courierName    String   @map("courier_name") @db.VarChar(100)
  /// driver | courier
  courierType    String   @map("courier_type") @db.VarChar(10)
  driverUserId   String?  @map("driver_user_id")
  /// المبلغ المحصَّل فعلاً — قد يخالف المتوقَّع (رفض الزبون قطعة)
  amount         Float
  /// إجمالي الطلب لحظة التحصيل — للمقارنة لا للحساب
  expectedAmount Float?   @map("expected_amount")
  note           String?  @db.VarChar(300)
  /// driver_app | merchant
  source         String   @default("merchant") @db.VarChar(20)
  recordedBy     String?  @map("recorded_by")
  collectedAt    DateTime @default(now()) @map("collected_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([businessId, businessType, courierKey])
  @@index([driverUserId])
  @@map("cod_collections")
}

/// تسليمُ مندوبٍ ما بيده للتاجر — جزئياً أو كاملاً.
///
/// **سجلٌّ لا رصيد:** رصيدٌ واحد يُعدَّل لا يقول متى سُلّم ماذا، والخلاف مع
/// المندوب يُحلّ بالتواريخ. والخطأ يُلغى بـ`voidedAt` لا بالحذف.
model CodHandover {
  id           String    @id @default(cuid())
  businessId   String    @map("business_id")
  businessType String    @map("business_type")
  courierKey   String    @map("courier_key") @db.VarChar(120)
  courierName  String    @map("courier_name") @db.VarChar(100)
  amount       Float
  note         String?   @db.VarChar(300)
  recordedBy   String?   @map("recorded_by")
  voidedAt     DateTime? @map("voided_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([businessId, businessType, courierKey])
  @@map("cod_handovers")
}
