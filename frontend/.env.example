# ==================================================
# frontend/.env.example
# انسخ إلى frontend/.env للتطوير المحلي.
#
# ⚠️ كل متغير يبدأ بـ VITE_ يُحقن داخل حزمة الجافاسكربت ويصبح مرئياً
# لأي زائر. لا تضع فيه أي سر حقيقي (مفاتيح خادم، كلمات مرور، توكنات).
# ==================================================

# رابط الـ API. اتركه فارغاً في الإنتاج مع النشر بتطبيق واحد
# وسيستخدم التطبيق /api على نفس الأصل تلقائياً.
VITE_API_URL=http://localhost:5000/api
VITE_BASE_URL=http://localhost:5000

# النطاق الأساسي للمنصة — يُستخدم لتمييز النطاقات الفرعية عن المخصصة
VITE_APP_DOMAIN=shamstores.com

VITE_FRONTEND_URL=https://shamstores.com
VITE_WHATSAPP=
VITE_R2_PUBLIC_URL=

# Firebase (قيم عامة بطبيعتها — احمِ مشروعك عبر قواعد Firebase ونطاقات مصرّح بها)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ==================== إشعارات المتصفّح (FCM) ====================
#
# مشروع الإشعارات قد يختلف عن مشروع المصادقة أعلاه — وهو واقع المنصّة اليوم:
# المصادقة على `shamstores`، والخادم وتطبيق السائق على `shamstores-ba667`.
# رمزٌ يُصدره مشروعٌ ويرسل إليه آخر ترفضه Google بـmismatched-credential،
# بلا أن يبدو شيءٌ معطّلاً.
#
# **يجب أن يطابق FIREBASE_PROJECT_ID على الخادم.** اتركها فارغة إن كان
# المشروعان واحداً — تعود الشيفرة إلى VITE_FIREBASE_* تلقائياً.
VITE_FCM_API_KEY=
VITE_FCM_AUTH_DOMAIN=
VITE_FCM_PROJECT_ID=
VITE_FCM_STORAGE_BUCKET=
VITE_FCM_MESSAGING_SENDER_ID=
VITE_FCM_APP_ID=

# شهادة Web Push من: Firebase Console ← Cloud Messaging ← Web Push certificates
# بدونها يرفض getToken بلا رسالة مفهومة
VITE_FIREBASE_VAPID_KEY=
